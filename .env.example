# Postgres connection string.
# Easiest: create a project on https://railway.com -> "Add PostgreSQL" ->
# Variables tab -> copy DATABASE_PUBLIC_URL. A locally installed Postgres works too:
# postgres://postgres:postgres@localhost:5432/shiplink
DATABASE_URL=

# Public URL of the app, used to build absolute links (short URLs, emails).
# http://localhost:3000 locally, your real domain in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
