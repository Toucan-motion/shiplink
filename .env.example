# Postgres connection string.
# Local Postgres: postgres://USER:PASSWORD@localhost:5432/shiplink
# Hosted: create a project on https://railway.com -> "Add PostgreSQL" ->
# Variables tab -> copy DATABASE_PUBLIC_URL.
DATABASE_URL=

# Random string used to sign sessions. Generate one with: npx auth secret
BETTER_AUTH_SECRET=

# Where the app runs. http://localhost:3000 locally, your domain in production.
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client: https://console.cloud.google.com/apis/credentials ->
# Create credentials -> OAuth client ID -> Web application. Authorized redirect URI:
# http://localhost:3000/api/auth/callback/google (add your prod domain later).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe, in test mode while developing: https://dashboard.stripe.com/test/apikeys
# -> "Secret key" (starts with sk_test_).
STRIPE_SECRET_KEY=

# Signing secret for webhooks (starts with whsec_).
# Locally: run `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# and copy the secret it prints. In production: Developers -> Webhooks -> your
# endpoint -> "Signing secret".
STRIPE_WEBHOOK_SECRET=

# Price id of the Pro plan (starts with price_). Create a product "Pro" with a
# recurring monthly price at https://dashboard.stripe.com/test/products and copy
# the id of the price, not of the product.
STRIPE_PRICE_PRO_MONTHLY=

# API key from https://resend.com/api-keys.
# Leave empty locally: emails are then printed to the terminal instead of sent.
RESEND_API_KEY=

# Sender address. onboarding@resend.dev works for testing; in production use an
# address on your own domain, verified at https://resend.com/domains.
EMAIL_FROM="ShipLink <onboarding@resend.dev>"

# Public URL of the app, used to build absolute links (short URLs, emails).
# http://localhost:3000 locally, your real domain in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
